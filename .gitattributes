# 设置默认行为（自动检测文本文件规范化行尾）
* text=auto

# 脚本特定换行符
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 源码与文档使用统一 LF
*.java text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.apk binary
*.jar binary
*.dex binary
*.jks binary
